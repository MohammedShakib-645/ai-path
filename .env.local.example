# --- AI-PATH environment template (copy values, never commit real keys) ---

# AI engine key pools (server-only — never expose to the browser)
GROQ_KEYS=
OPENROUTER_KEYS=
GEMINI_KEYS=

# Supabase auth backend (Project Settings -> API)
# NEXT_PUBLIC_* values are safe for the browser (anon key is public by design).
# The service_role key must NEVER be added to this app.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Comma-separated OAuth buttons to show once Supabase providers have credentials
# e.g. google,github  (empty = buttons hidden, no dead/error buttons)
NEXT_PUBLIC_OAUTH_PROVIDERS=
